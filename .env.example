# Application
HERBIE_ENVIRONMENT=local
HERBIE_LOG_LEVEL=INFO
HERBIE_API_HOST=0.0.0.0
HERBIE_API_PORT=8000
HERBIE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL
HERBIE_DATABASE_URL=postgresql+asyncpg://herbie:local_only@postgres:5432/herbie
POSTGRES_DB=herbie
POSTGRES_USER=herbie
POSTGRES_PASSWORD=local_only

# RabbitMQ and MQTT
HERBIE_AMQP_URL=amqp://herbie:local_only@rabbitmq:5672/%2F
HERBIE_MQTT_HOST=rabbitmq
HERBIE_MQTT_PORT=1883
RABBITMQ_DEFAULT_USER=herbie
RABBITMQ_DEFAULT_PASS=local_only

# DynamoDB Local
HERBIE_DYNAMODB_ENDPOINT=http://dynamodb:8000
HERBIE_DYNAMODB_REGION=us-east-1
HERBIE_DYNAMODB_TELEMETRY_TABLE=herbie-telemetry-local
HERBIE_TELEMETRY_EVENT_RETENTION_DAYS=14
HERBIE_TELEMETRY_REPLAY_RETENTION_DAYS=180
AWS_ACCESS_KEY_ID=herbie
AWS_SECRET_ACCESS_KEY=local_only_change_me

# MinIO (S3-compatible local archive)
HERBIE_S3_ENDPOINT=http://minio:9000
HERBIE_S3_BUCKET=herbie-raw-local
MINIO_ROOT_USER=herbie
MINIO_ROOT_PASSWORD=local_only_change_me
